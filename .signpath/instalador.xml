<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de artefacto "instalador" en SignPath: firma el instalador NSIS. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <pe-file path="Citrus-Setup-${version}.exe" product-name="Citrus" product-version="${version}">
    <authenticode-sign />
  </pe-file>
</artifact-configuration>
