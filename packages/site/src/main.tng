let AUTO_MS = 7000

fn draw_features() {
  let viewer = rv(el("div", "viewer"), 2)
  let tabs = append(viewer, el("div", "viewer-tabs"))
  attr(tabs, "role", "tablist")
  attr(tabs, "aria-label", "Funciones de Citrus")
  let frame = append(viewer, el("div", "frame shots"))
  let shots = []
  let buttons = []
  for f in FEATURES { shots.push(append(frame, image("assets/{f.image}", f.alt, "shot"))) }
  let copy_row = append(viewer, el("div", "viewer-copy"))
  let title = append(copy_row, el("h3", nil, FEATURES[0].title))
  let body = append(copy_row, el("p", nil, FEATURES[0].text))
  var current = 0
  var auto = !reduced_motion()
  var timer_id = 0

  fn pick(i, animate = true) {
    current = i
    let f = FEATURES[i]
    for (j, s) in shots.enumerate() {
      toggle_class(s, "on", j == i)
      attr(s, "aria-hidden", if j == i { nil } else { "true" })
    }
    set_text(title, f.title)
    set_text(body, f.text)
    if animate {
      enter_anim(title)
      enter_anim(body)
    }
    for (j, b) in buttons.enumerate() {
      attr(b, "aria-selected", if j == i { "true" } else { "false" })
      toggle_class(b, "running", false)
    }
  }

  // Avanza solo hasta que la persona elige algo: desde ahí, manda ella.
  fn schedule() {
    timer_id += 1
    let me = timer_id
    if !auto { return nil }
    toggle_class(buttons[current], "running", true)
    after(AUTO_MS, || {
      if me == timer_id && auto {
        pick((current + 1) % FEATURES.len())
        schedule()
      }
    })
  }

  for (i, f) in FEATURES.enumerate() {
    let b = append(tabs, el("button", nil, f.tab))
    attr(b, "role", "tab")
    append(b, el("span", "tab-bar"))
    on(b, "click", || {
      auto = false
      timer_id += 1
      pick(i)
    })
    buttons.push(b)
  }
  pick(0, false)
  on_view(frame, schedule, || {
    timer_id += 1
    for b in buttons { toggle_class(b, "running", false) }
  })

  section_block("funciones", [
    rv(el("h2", nil, "Mira adentro de cada request.")),
    rv(el("p", "sub", "Capturas reales de la app, con la demo incluida en el proyecto."), 1),
    viewer,
  ])
}

// ---------- Archivos ----------

fn draw_files() {
  let left = el("div", "sticky")
  append(left, rv(el("h2", nil, "Tus colecciones son archivos.")))
  append(left, rv(el("p", "sub", "Cada request es un YAML legible que vive en tu repositorio y se revisa en un PR. Citrus respeta tus comentarios al guardar."), 1))
  append(left, rv(el("p", "sub", "No necesitas cuenta: nada sale de tu equipo salvo lo que tú envías."), 2))
  let file = yaml_block("collections/orders/create-order.citrus.yaml", [
    'name: Crear pedido',
    'method: POST',
    'url: "{{baseUrl}}/orders"',
    'headers:',
    '  Authorization: "Bearer {{token}}"',
    'body:',
    '  json:',
    '    productId: 42',
    '    quantity: 2',
    'observe:',
    '  logs: true',
    '  lambda: orders-service-{{stage}}-createOrder',
    '  db:',
    '    connection: main',
    '    tables: [orders, order_items]',
    'assert:',
    '  - status == 201',
    '  - body.id exists',
    '  - db.orders.inserted == 1',
    '  - logs.errors == 0',
    '  - lambda.duration < 500',
    'capture:',
    '  lastOrderId: body.id',
  ])
  section_block("archivos", [node("div", "split", [left, file])])
}

// ---------- Descargar ----------

fn install_step(label, cmd, note = nil) {
  let s = el("div", "install-step")
  append(s, el("p", nil, label))
  append(s, command(cmd))
  if note != nil { append(s, el("small", nil, note)) }
  s
}

// ---------- Encuesta tras descargar ----------
// Tres preguntas opcionales. Las respuestas van al Google Form siempre en español.

let ES = ui_lang() == "es"
fn tr(es, en) { if ES { es } else { en } }

let AREAS = [
  ["Backend", "Backend"], ["Frontend", "Frontend"], ["Full stack", "Full stack"], ["Móvil", "Mobile"],
  ["QA / Testing", "QA / Testing"], ["DevOps / Cloud", "DevOps / Cloud"], ["Estudiante", "Student"], ["Otro", "Other"],
]
let USES = [
  ["HTTP / APIs", "HTTP / APIs"], ["MySQL", "MySQL"], ["AWS Lambda", "AWS Lambda"], ["Todo un poco", "A bit of everything"],
]

// Botones de los que solo uno queda marcado. Devuelve una función que da el valor elegido (en español).
fn choices(parent, options) {
  var chosen = nil
  let row = append(parent, el("div", "chips"))
  attr(row, "role", "radiogroup")
  var buttons = []
  for o in options {
    let b = append(row, el("button", "chip", tr(o[0], o[1])))
    attr(b, "role", "radio")
    attr(b, "aria-checked", "false")
    buttons.push(b)
    on(b, "click", || {
      chosen = if chosen == o[0] { nil } else { o[0] }
      for x in buttons {
        let on_now = chosen != nil && x == b
        toggle_class(x, "on", on_now)
        attr(x, "aria-checked", if on_now { "true" } else { "false" })
      }
    })
  }
  || chosen
}

fn survey_field(parent, label) {
  let f = append(parent, el("div", "sv-field"))
  append(f, el("span", "sv-label", label))
  f
}

var survey_dialog = nil

fn open_survey() {
  if load("citrus-survey") != nil { return nil }
  if survey_dialog != nil { open_modal(survey_dialog); return nil }

  let d = append(root, el("dialog", "survey"))
  attr(d, "aria-labelledby", "sv-title")
  survey_dialog = d
  let close_btn = append(d, el("button", "sv-close", "×"))
  attr(close_btn, "aria-label", tr("Cerrar", "Close"))

  let body = append(d, el("div", "sv-body"))
  let title = append(body, el("h3", nil, tr("Tu descarga ya empezó", "Your download has started")))
  attr(title, "id", "sv-title")
  append(body, el("p", "sv-sub", tr("¿Nos cuentas un poco de ti? Son tres preguntas y todas son opcionales.", "Tell us a bit about yourself? Three questions, all optional.")))

  let list = countries()
  let country_f = survey_field(body, tr("¿De qué país eres?", "Where are you from?"))
  let country = append(country_f, el("input", "sv-input"))
  attr(country, "list", "sv-countries")
  attr(country, "autocomplete", "country-name")
  attr(country, "placeholder", tr("Escribe para buscar", "Type to search"))
  let guess = guess_country()
  if guess != nil { set_value(country, guess) }
  let dl = append(country_f, el("datalist"))
  attr(dl, "id", "sv-countries")
  for c in list {
    let o = append(dl, el("option"))
    attr(o, "value", c[0])
  }

  let area = choices(survey_field(body, tr("Área de desarrollo", "Development area")), AREAS)
  let use = choices(survey_field(body, tr("¿Qué vas a usar más?", "What will you use most?")), USES)

  let actions = append(body, el("div", "sv-actions"))
  let later = append(actions, el("button", "btn", tr("Ahora no", "Not now")))
  let send = append(actions, el("button", "btn primary", tr("Enviar", "Send")))

  fn done() {
    save("citrus-survey", "1")
    close_modal(d)
  }
  on(close_btn, "click", done)
  on(later, "click", done)
  on(send, "click", || {
    let typed = value(country).trim()
    var country_es = if typed == "" { nil } else { typed }
    for c in list {
      if c[0].lower() == typed.lower() { country_es = c[1] }
    }
    send_survey(country_es, area(), use())
    save("citrus-survey", "1")
    clear(body)
    toggle_class(d, "sent", true)
    append(body, el("div", "sv-thanks-mark", "🍊"))
    append(body, el("h3", nil, tr("¡Gracias!", "Thank you!")))
    append(body, el("p", "sv-sub", tr("Que disfrutes Citrus.", "Enjoy Citrus.")))
    after(1800, || close_modal(d))
  })
  open_modal(d)
}

fn draw_download_card() {
  let card = rv(el("div", "dl-card"), 1)
  append(card, el("div", "dl-kicker", "Windows 64 bits · versión {RELEASE.version}"))
  let button = append(card, link("btn primary dl-btn", "Descargar Citrus", RELEASE.url))
  attr(button, "download", RELEASE.file)
  on(button, "click", || after(600, open_survey))
  append(card, el("div", "dl-meta", "{RELEASE.file} · {RELEASE.size}"))

  let warn = append(card, el("div", "dl-warn"))
  append(warn, el("b", nil, "Windows te va a avisar. "))
  add_text(warn, "El instalador todavía no está firmado, así que SmartScreen muestra «Windows protegió tu PC». Para seguir, elige Más información y después Ejecutar de todas formas.")

  let hash = append(card, el("div", "dl-hash"))
  append(hash, el("span", nil, "SHA-256, para comprobar la descarga"))
  let value_row = append(hash, el("div", "code cmd"))
  append(value_row, node("pre", nil, [el("code", nil, RELEASE.sha256)]))
  let b = append(value_row, el("button", "copy", "Copiar"))
  attr(b, "aria-label", "Copiar el SHA-256")
  on(b, "click", || copy(RELEASE.sha256, b))
  card
}

fn draw_download() {
  let left = el("div", "sticky")
  append(left, rv(el("h2", nil, "Descargar Citrus")))
  if RELEASE != nil {
    append(left, rv(el("p", "sub", "Instálalo y ábrelo. No necesitas Node, cuenta ni nada más."), 1))
    let reqs = rv(append(left, el("ul", "reqs")), 2)
    for r in [
      ["Sistema", " Windows de 64 bits. Probado en Windows 11"],
      ["Espacio", " unos 300 MB una vez instalado"],
      ["macOS y Linux", " aún no: corre desde el código, sin probar"],
    ] {
      let li = append(reqs, el("li"))
      append(li, el("b", nil, r[0]))
      add_text(li, r[1])
    }
  } else {
    append(left, rv(el("p", "sub", "Por ahora Citrus se corre desde el código."), 1))
  }

  let right = el("div", "stack")
  if RELEASE != nil { append(right, draw_download_card()) }

  let source = rv(el("div", "stack"), 2)
  append(source, el("h3", "source-title", "Desde el código"))
  append(source, el("p", "source-note", "Para desarrollar Citrus o probar la demo, que trae una API de ejemplo, MySQL temporal y CloudWatch simulado para verlo todo sin cuenta de AWS. Necesitas Node.js 20 o más reciente."))
  if REPO_URL != nil {
    append(source, install_step("1. Baja el código", "git clone {REPO_URL} citrus && cd citrus"))
  } else {
    let s = append(source, el("div", "install-step"))
    append(s, el("p", nil, "1. Consigue el código"))
    append(s, el("small", nil, "El repositorio público está por publicarse. Mientras tanto, abre una terminal en la carpeta del proyecto."))
  }
  append(source, install_step("2. Instala las dependencias", "npm install"))
  append(source, install_step("3. Abre la app", "npm start"))
  append(source, install_step("4. Opcional: levanta la demo", "npm run demo:api", "Déjala corriendo en otra terminal y elige Probar la demo en la app. La primera vez descarga MySQL."))
  append(right, source)
  section_block("descargar", [node("div", "split", [left, right])])
}

// ---------- Usar ----------

fn flow_item(n, title, parts, extra = nil) {
  let li = rv(el("li"), n % 3)
  append(li, el("h3", nil, title))
  append(li, rich("p", nil, parts))
  if extra != nil { append(li, extra) }
  li
}

fn draw_usage() {
  let left = el("div", "sticky")
  append(left, rv(el("h2", nil, "Cómo usarlo")))
  append(left, rv(el("p", "sub", "De la instalación a tu primer request con logs."), 1))
  let keys = rv(append(left, el("dl", "keys")), 2)
  for k in [
    ["Ctrl K", "buscar o ejecutar una acción"],
    ["Ctrl Enter", "enviar"],
    ["Ctrl S", "guardar"],
    ["Ctrl W", "cerrar la pestaña"],
  ] {
    append(keys, node("dt", nil, [el("kbd", nil, k[0])]))
    append(keys, el("dd", nil, k[1]))
  }

  let flow = el("ol", "flow")
  append(flow, flow_item(0, "Abre o crea un workspace", ["Un workspace es una carpeta con ", ["citrus.config.yaml"], ", tus colecciones y tus entornos. Ponla en el repositorio de tu backend."]))
  append(flow, flow_item(1, "Trae tus endpoints", ["En Importar, elige tu ", ["serverless.yml"], " o template de SAM, una colección de Postman v2 o un comando cURL. Las credenciales pasan al llavero."]))
  append(flow, flow_item(2, "Define el entorno", ["En el icono de entornos van las variables y los secretos. Los usas como ", ['{{baseUrl}}'], ". Un entorno protegido pide confirmación antes de cualquier envío que no sea GET."]))
  append(flow, flow_item(3, "Envía", ["Con ", ["Ctrl Enter"], " ves la respuesta, sus tiempos por fase y los tests."]))
  append(flow, flow_item(4, "Conecta AWS para ver los logs", ["En la pestaña Observar, activa los logs e indica la función. Citrus usa tus credenciales de AWS, por perfil o por la cadena estándar, y nunca las guarda. Tu usuario necesita ", ["logs:FilterLogEvents"], "."]))
  append(flow, flow_item(5, "Conecta MySQL para ver los cambios", ["Agrega la conexión al entorno y elige las tablas en Observar. Conviene un usuario de solo lectura. Para el modo binlog, ese usuario necesita ", ["REPLICATION SLAVE"], " y ", ["REPLICATION CLIENT"], "."], yaml_block("environments/staging.yaml", [
    'aws:',
    '  profile: mi-perfil',
    '  region: us-east-1',
    'db:',
    '  main:',
    '    host: staging-proxy.xxxx.rds.amazonaws.com',
    '    database: app',
    '    user: citrus_readonly',
    '    passwordSecret: dbPassword',
    '    mode: snapshot',
  ])))
  append(flow, flow_item(6, "Invoca una Lambda", ["Crea o importa una request de tipo Lambda, elige una plantilla de evento y pulsa Invocar. En modo Local corre tu handler en tu equipo; en modo AWS invoca la función real."]))
  section_block("usar", [node("div", "split", [left, flow])])
}

// ---------- Seguridad ----------

fn draw_security() {
  let grid = el("div", "facts")
  for (i, f) in [
    ["Secretos en el llavero del sistema", "Keychain, Credential Manager o libsecret. En el YAML solo queda el nombre, y el historial no guarda headers ni bodies."],
    ["La base solo se lee", "El modo snapshot solo ejecuta SELECT, dentro de una transacción de solo lectura. Si el usuario puede escribir, Citrus te avisa al probar la conexión."],
    ["Pregunta antes de ejecutar código", "Correr un handler en local ejecuta código del proyecto, con las variables y secretos del entorno. Citrus pide confirmación una vez por carpeta."],
    ["Sin telemetría", "Citrus no envía datos de uso. Solo se conecta a lo que tú le pides: tu API, tu AWS y tu base."],
  ].enumerate() {
    append(grid, rv(node("div", nil, [el("h3", nil, f[0]), el("p", nil, f[1])]), i))
  }
  section_block("seguridad", [rv(el("h2", nil, "Hecho para repositorios compartidos.")), grid])
}

// ---------- Estado ----------

fn draw_status() {
  let left = el("div", "sticky")
  append(left, rv(el("h2", nil, "En qué va")))
  append(left, rv(el("p", "sub", "Citrus está en desarrollo. Esto funciona hoy y esto falta."), 1))
  let list = el("ul", "status-list")
  for (i, s) in [
    ["done", "Listo", "Cliente HTTP", "JSON, form, multipart, Bearer, Basic, API Key, entornos, secretos, historial e importación de cURL y Postman."],
    ["done", "Listo", "Serverless", "Importa serverless.yml y SAM. Invoca Lambda en local y en AWS con plantillas de eventos."],
    ["done", "Listo", "Logs y métricas", "CloudWatch por invocación, duración, memoria, cold start y X-Ray."],
    ["done", "Listo", "Base de datos", "Diff de MySQL por snapshot y binlog, con tests sobre las filas."],
    ["next", "Falta", "CLI y CI", "citrus run y reportes JUnit. Los flujos ya corren desde la app."],
    ["next", "Falta", "Servidor MCP", "Para que un agente de IA pruebe su propio cambio."],
    ["next", "Falta", "Otros formatos", "GraphQL, SigV4, OAuth 2.0, scripts, CDK, OpenAPI e Insomnia."],
    ["next", "Falta", "macOS y Linux", "Instaladores y pruebas en esos sistemas."],
  ].enumerate() {
    let li = rv(append(list, el("li")), i % 4)
    append(li, el("span", "badge {s[0]}", s[1]))
    append(li, node("div", nil, [el("b", nil, s[2]), el("p", nil, s[3])]))
  }
  append(left, rv(el("p", "sub", "Probado contra MySQL real. CloudWatch y Lambda en AWS solo se han probado contra un emulador, y RDS o Aurora aún no."), 2))
  section_block("estado", [node("div", "split", [left, list])])
}

// ---------- Pie ----------

fn draw_footer() {
  let foot = el("footer", "foot")
  let w = append(foot, el("div", "wrap foot-in"))
  let tag = append(w, el("span"))
  add_text(tag, "Citrus. Licencia MIT.")
  let made = append(w, el("span"))
  add_text(made, "Esta página y la interfaz de la app están escritas en ")
  let a = append(made, link(nil, "Tangerine", "https://www.npmjs.com/package/tangerine-lang"))
  attr(a, "rel", "noopener")
  add_text(made, ".")
  foot
}

