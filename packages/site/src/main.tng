// Página de Citrus, escrita en Tangerine.
import { RELEASE } from "./release.tng"

// Cuando el código esté publicado, pon aquí su URL: el paso de instalación desde el código la usa.
let REPO_URL = "https://github.com/ManuelOsmaDev/citrus"

let root = query("#app")

// ---------- Piezas ----------

fn node(tag, cls, children = []) {
  let e = el(tag, cls)
  for c in children {
    if c != nil { append(e, c) }
  }
  e
}

fn link(cls, label, href) {
  let a = el("a", cls, label)
  attr(a, "href", href)
  a
}

fn image(src, alt, cls = nil) {
  let i = el("img", cls)
  attr(i, "src", src)
  attr(i, "alt", alt)
  attr(i, "width", "1440")
  attr(i, "height", "900")
  i
}

// Marca un elemento para que entre al hacer scroll. `i` es su turno dentro del grupo.
fn rv(e, i = 0) {
  toggle_class(e, "reveal", true)
  set_style(e, "--i", i)
  e
}

fn section_block(id, children) {
  let s = el("section")
  attr(s, "id", id)
  let w = append(s, el("div", "wrap block"))
  for c in children {
    if c != nil { append(w, c) }
  }
  s
}

// Texto con `código` adentro, sin escribir HTML a mano.
fn rich(tag, cls, parts) {
  let e = el(tag, cls)
  for p in parts {
    if type_of(p) == "List" { append(e, el("code", nil, p[0])) } else { add_text(e, p) }
  }
  e
}

fn command(text) {
  let box_el = el("div", "code cmd")
  append(box_el, node("pre", nil, [el("code", nil, text)]))
  let b = append(box_el, el("button", "copy", "Copiar"))
  attr(b, "aria-label", "Copiar: {text}")
  on(b, "click", || copy(text, b))
  box_el
}

// Colorea solo las claves: suficiente para leer un YAML sin cargar un resaltador.
fn yaml_block(label, lines) {
  let box_el = el("div", "code")
  append(box_el, el("div", "code-label", label))
  let body = el("code")
  for (n, line) in lines.enumerate() {
    let row = rv(append(body, el("span", "y-line")), n)
    let at = line.index_of(":")
    let trimmed = line.trim()
    if trimmed.starts_with("#") {
      append(row, el("span", "y-note", line))
    } else if at != nil && at > 0 && !trimmed.starts_with("-") {
      append(row, el("span", "y-key", line.slice(0, at)))
      add_text(row, line.slice(at))
    } else {
      add_text(row, line)
    }
  }
  append(box_el, node("pre", nil, [body]))
  box_el
}

// ---------- Navegación ----------

// El nombre con la rodaja como punto de la i. La rodaja toma el color del texto.
fn wordmark() {
  let word = el("span", "wordmark")
  attr(word, "aria-hidden", "true")
  add_text(word, "c")
  let i = append(word, el("span", "wm-i", "ı"))
  append(i, el("span", "wm-dot"))
  add_text(word, "trus")
  word
}

fn draw_nav() {
  let nav = el("header", "nav")
  append(nav, el("div", "progress"))
  let inner = append(nav, el("div", "wrap nav-in"))
  let brand = append(inner, link("brand", nil, "#inicio"))
  attr(brand, "aria-label", "Citrus, inicio")
  append(brand, wordmark())
  let links = append(inner, el("nav", "nav-links"))
  attr(links, "aria-label", "Secciones")
  for item in [["Qué es", "#que-es"], ["Funciones", "#funciones"], ["Descargar", "#descargar"], ["Usar", "#usar"], ["Estado", "#estado"]] {
    append(links, link(nil, item[0], item[1]))
  }
  append(inner, link("btn primary small", "Descargar", "#descargar"))
  nav
}

// ---------- Consola en vivo ----------
// Todo existe desde el principio y solo cambia su visibilidad: la página no salta mientras se anima.

let URL_VAR = '{{baseUrl}}'
let URL_PATH = "/orders"

fn draw_console() {
  let items = []
  let box_el = el("div", "console")
  attr(box_el, "role", "img")
  attr(box_el, "aria-label", "Simulación de Citrus: un POST a /orders responde 201 en 96 milisegundos. En la misma pantalla aparecen los logs de la Lambda, un cold start, las filas nuevas en MySQL y cinco tests cumplidos.")
  let inner = append(box_el, el("div", "c-inner"))
  attr(inner, "aria-hidden", "true")

  fn item(e, cls = "c-item") {
    toggle_class(e, cls, true)
    items.push(e)
    e
  }

  // Barra de la request
  let bar = append(inner, el("div", "c-bar"))
  append(bar, el("span", "c-method", "POST"))
  let url = append(bar, el("span", "c-url"))
  let url_var = append(url, el("span", "c-var"))
  let url_path = append(url, el("span"))
  let caret = append(url, el("span", "c-caret"))
  let send_btn = append(bar, el("span", "c-send", "Enviar"))

  let grid = append(inner, el("div", "c-grid"))

  // Respuesta
  let response = append(grid, el("div", "c-pane"))
  append(response, el("div", "c-title", "Respuesta"))
  let wait = append(response, el("div", "c-wait", "Esperando…"))
  let status = item(append(response, el("div", "c-status")))
  append(status, el("b", nil, "201"))
  add_text(status, " Created")
  let time = append(status, el("span", "c-time", "0 ms"))
  let phases = item(append(response, el("div", "c-phases")), "c-phases-item")
  for p in [[2, "var(--c-a)"], [3, "var(--c-b)"], [86, "var(--accent)"], [2, "var(--c-c)"]] {
    let seg = append(phases, el("span"))
    set_style(seg, "flex", "{p[0]} 1 0")
    set_style(seg, "background", p[1])
  }
  let json = append(response, el("div", "c-json"))
  let json_lines = []
  for line in ['{', '  "id": 1009,', '  "productId": 42,', '  "status": "pending"', '}'] {
    json_lines.push(item(append(json, el("div", nil, line))))
  }

  // Logs
  let logs = append(grid, el("div", "c-pane"))
  append(logs, el("div", "c-title", "Logs de CloudWatch"))
  let log_rows = []
  for l in [
    ["sys", "START RequestId: 7cc8…f457c"],
    ["info", "Procesando createOrder"],
    ["info", '{ "msg": "Consulta a MySQL" }'],
    ["warn", "Stock bajo para el producto 42"],
    ["sys", "REPORT Duration: 87 ms"],
  ] {
    let row = item(append(logs, el("div", "c-log {l[0]}")))
    append(row, el("i", nil, if l[0] == "sys" { "λ" } else { l[0] }))
    append(row, el("span", nil, l[1]))
    log_rows.push(row)
  }
  let pills = append(logs, el("div", "c-pills"))
  let pill_time = item(append(pills, el("span", "c-pill", "87 ms en Lambda")))
  let pill_mem = item(append(pills, el("span", "c-pill", "76 MB")))
  let pill_cold = item(append(pills, el("span", "c-pill cold", "Cold start")))

  // Base de datos y tests
  let side = append(grid, el("div", "c-pane"))
  append(side, el("div", "c-title", "MySQL"))
  let db_a = item(append(side, el("div", "c-row")))
  append(db_a, el("b", nil, "orders"))
  append(db_a, el("span", nil, "+ 1009 · pending"))
  let db_b = item(append(side, el("div", "c-row")))
  append(db_b, el("b", nil, "order_items"))
  append(db_b, el("span", nil, "+ SKU-42 · 60000"))
  append(side, el("div", "c-title c-title-2", "Tests"))
  let test_rows = []
  for t in ["status == 201", "body.id exists", "db.orders.inserted == 1", "logs.errors == 0", "lambda.duration < 500"] {
    let row = item(append(side, el("div", "c-test")))
    append(row, el("i", nil, "✓"))
    append(row, el("span", nil, t))
    test_rows.push(row)
  }

  var run_id = 0

  fn set_url(n) {
    set_text(url_var, URL_VAR.slice(0, min(n, URL_VAR.len())))
    set_text(url_path, if n > URL_VAR.len() { URL_PATH.slice(0, n - URL_VAR.len()) } else { "" })
  }

  fn turn_on(e) {
    toggle_class(e, "on", true)
  }

  fn reset() {
    toggle_class(box_el, "instant", true)
    for e in items { toggle_class(e, "on", false) }
    toggle_class(wait, "on", false)
    toggle_class(caret, "on", true)
    toggle_class(send_btn, "press", false)
    set_text(time, "0 ms")
    set_url(0)
    toggle_class(box_el, "fading", false)
    after(30, || toggle_class(box_el, "instant", false))
  }

  // Línea de tiempo: [milisegundos, qué pasa].
  fn timeline() {
    let full = URL_VAR.len() + URL_PATH.len()
    let steps = []
    for n in 1..=full { steps.push([250 + n * 36, || set_url(n)]) }
    let send_at = 250 + full * 36 + 260
    steps.push([send_at, || {
      toggle_class(caret, "on", false)
      toggle_class(send_btn, "press", true)
      toggle_class(wait, "on", true)
    }])
    steps.push([send_at + 130, || toggle_class(send_btn, "press", false)])
    let answer = send_at + 650
    steps.push([answer, || {
      toggle_class(wait, "on", false)
      turn_on(status)
      turn_on(phases)
    }])
    for (i, v) in [14, 38, 63, 84, 96].enumerate() {
      steps.push([answer + i * 70, || set_text(time, "{v} ms")])
    }
    for (i, line) in json_lines.enumerate() { steps.push([answer + 120 + i * 60, || turn_on(line)]) }
    let logs_at = answer + 500
    for (i, row) in log_rows.enumerate() { steps.push([logs_at + i * 300, || turn_on(row)]) }
    let pills_at = logs_at + log_rows.len() * 300
    for (i, p) in [pill_time, pill_mem, pill_cold].enumerate() { steps.push([pills_at + i * 80, || turn_on(p)]) }
    let db_at = pills_at + 320
    steps.push([db_at, || turn_on(db_a)])
    steps.push([db_at + 140, || turn_on(db_b)])
    let tests_at = db_at + 420
    for (i, row) in test_rows.enumerate() { steps.push([tests_at + i * 150, || turn_on(row)]) }
    { steps: steps, end: tests_at + test_rows.len() * 150 + 3600 }
  }

  fn play() {
    run_id += 1
    let me = run_id
    reset()
    let plan = timeline()
    for step in plan.steps {
      after(step[0], || {
        if me == run_id { step[1]() }
      })
    }
    after(plan.end, || {
      if me == run_id {
        toggle_class(box_el, "fading", true)
        after(380, || {
          if me == run_id { play() }
        })
      }
    })
  }

  // Con movimiento reducido se ve el resultado final, sin bucle.
  fn draw_final() {
    set_url(URL_VAR.len() + URL_PATH.len())
    set_text(time, "96 ms")
    for e in items { toggle_class(e, "on", true) }
  }

  if reduced_motion() {
    draw_final()
  } else {
    reset()
    // Fuera de pantalla no corre: no gasta batería en algo que nadie mira.
    on_view(box_el, play, || {
      run_id += 1
    })
  }
  box_el
}

// ---------- Portada ----------

fn draw_hero() {
  let hero = el("div", "hero")
  attr(hero, "id", "inicio")
  let slice = append(hero, el("span", "hero-slice"))
  attr(slice, "aria-hidden", "true")
  let w = append(hero, el("div", "wrap hero-in"))
  append(w, el("h1", "rise", "Lo que tu endpoint respondió, y lo que pasó adentro."))
  let lead = append(w, el("p", "lead rise", "Citrus es un cliente de APIs para backends serverless. Mandas un request y ves en la misma pantalla la respuesta, los logs de esa invocación, el cold start y las filas que cambió en MySQL."))
  set_style(lead, "--i", 1)
  let actions = append(w, node("div", "hero-actions rise", [
    link("btn primary", if RELEASE != nil { "Descargar para Windows" } else { "Instalar Citrus" }, "#descargar"),
    link("btn", "Ver qué hace", "#funciones"),
  ]))
  set_style(actions, "--i", 2)
  let note = append(w, el("p", "hero-note rise", "Código abierto con licencia MIT. Sin cuenta y sin nube. En desarrollo."))
  set_style(note, "--i", 3)
  let shot = append(w, el("div", "hero-console rise"))
  set_style(shot, "--i", 4)
  append(shot, draw_console())
  append(shot, el("p", "console-note", "Simulación con datos de ejemplo. Abajo están las capturas reales."))
  hero
}

// ---------- Qué es ----------

fn draw_what() {
  let left = el("div", "sticky")
  append(left, rv(el("h2", nil, "Depurar un endpoint no debería ser abrir cuatro programas.")))
  append(left, rv(el("p", "sub", "Los clientes de APIs responden qué devolvió el endpoint. Lo demás te toca buscarlo a mano."), 1))
  let list = el("ol", "steps-old")
  for (i, t) in [
    "Mandas el request desde tu cliente de APIs.",
    "Abres la consola de AWS, buscas el log group y filtras por hora hasta dar con la invocación.",
    "Abres un cliente de MySQL y revisas a mano qué filas cambiaron.",
    "Para un evento de SQS o S3, armas el JSON a mano y lo invocas desde la AWS CLI.",
  ].enumerate() {
    let li = rv(append(list, el("li")), i)
    append(li, el("span", "strike", t))
  }
  let result = rv(el("div", "result", "En Citrus todo eso es una sola pantalla, y tus colecciones son archivos YAML que revisas en un PR."), 6)
  let right = node("div", nil, [list, result])
  section_block("que-es", [node("div", "split", [left, right])])
}

